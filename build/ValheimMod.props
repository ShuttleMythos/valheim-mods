<Project>
  <!--
    Gemeinsame Einstellungen für alle Mods in diesem Repository.
    Ein Mod bindet sie in seiner .csproj ein mit:
      <Import Project="../build/ValheimMod.props" />
    Nach einem Valheim-Update werden die Versionen nur hier angepasst.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- Tests laufen als eigene Projekte außerhalb des Spiels -->
    <Compile Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Referenz-DLLs von Valheim 1.0 (nur zum Kompilieren, werden nicht mit ausgeliefert) -->
    <PackageReference Include="Digitalroot.Valheim.Common.References" Version="1.0.22" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="JotunnLib" Version="2.30.3" PrivateAssets="all" ExcludeAssets="runtime;build" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" PrivateAssets="all" ExcludeAssets="runtime" IncludeAssets="compile" />
  </ItemGroup>
</Project>
